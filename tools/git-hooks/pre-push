#!/usr/bin/env bash
# main push 시 웹 빌드 자동 배포. 건너뛰기: SKIP_DEPLOY=1 git push
# 배포 실패는 경고만 출력하고 push는 진행.
set -uo pipefail

[[ "${SKIP_DEPLOY:-0}" == "1" ]] && exit 0

ZERO="0000000000000000000000000000000000000000"
HEAD_SHA="$(git rev-parse HEAD)"
deploy=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
	[[ "$remote_ref" == "refs/heads/main" && "$local_sha" != "$ZERO" ]] || continue
	if [[ "$local_sha" != "$HEAD_SHA" ]]; then
		echo "[pre-push] push 대상($local_sha)이 HEAD와 달라 배포를 건너뜁니다." >&2
		continue
	fi
	deploy=1
done

[[ $deploy -eq 1 ]] || exit 0

ROOT="$(git rev-parse --show-toplevel)"
if ! "$ROOT/tools/deploy_web.sh"; then
	echo "[pre-push] ⚠ 웹 배포 실패 — main push는 계속 진행합니다." >&2
fi
exit 0
