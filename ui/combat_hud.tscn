[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://ui/combat_hud.gd" id="1_hud"]

[sub_resource type="Shader" id="Shader_vignette"]
code = "shader_type canvas_item;
uniform vec4 tint : source_color = vec4(0.09, 0.086, 0.106, 1.0);
uniform float strength = 0.9;
void fragment() {
	float d = distance(UV, vec2(0.5));
	COLOR = vec4(tint.rgb, smoothstep(0.3, 0.8, d) * strength);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_vignette"]
shader = SubResource("Shader_vignette")

[sub_resource type="StyleBoxFlat" id="Style_mana_bg"]
bg_color = Color(0.122, 0.114, 0.141, 0.9)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="StyleBoxFlat" id="Style_mana_fill"]
